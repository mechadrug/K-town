# ===== K-town .gitignore（重写，2026-08-04）=====

# ---- 个人工作目录 ----
docs-local/

# ---- 本地配置（含 API 密钥）----
config.yaml

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 运行时数据库（不入库）----
k_town.db
k_town.db-shm
k_town.db-wal
test_*.db
test_*.db-shm
test_*.db-wal
static_data/

# ---- 日志 / 临时 ----
*.log
*.tmp
*.stdin
scripts/server.pid

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
